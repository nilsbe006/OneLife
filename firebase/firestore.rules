rules_version = '2';

// ONE LIFE. NO LIMITS. – Zugriffsregeln
// Nur Accounts mit einem Dokument in /members/{uid} haben Zugriff.
service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() { return request.auth != null; }
    function isMember() {
      return signedIn() && exists(/databases/$(database)/documents/members/$(request.auth.uid));
    }
    function isMe(uid) { return signedIn() && request.auth.uid == uid; }
    function incoming() { return request.resource.data; }
    function onlyChanges(keys) {
      return incoming().diff(resource.data).affectedKeys().hasOnly(keys);
    }

    // Allowlist & Profile – werden manuell in der Konsole angelegt
    match /members/{uid} {
      allow read: if isMember();
      allow update: if isMember() && isMe(uid) && onlyChanges(['displayName', 'avatar']);
      allow create, delete: if false;
    }

    // Persönliche Bewertung / Favorit / Notiz – jeder sieht alles, schreibt nur eigenes
    // Dokument-ID: {uid}_{activityId}
    match /ratings/{docId} {
      allow read: if isMember();
      allow create, update: if isMember()
        && incoming().uid == request.auth.uid
        && docId == request.auth.uid + '_' + incoming().activityId
        && (!('rating' in incoming()) || incoming().rating == null
            || (incoming().rating is int && incoming().rating >= 0 && incoming().rating <= 5))
        && (!('note' in incoming()) || (incoming().note is string && incoming().note.size() <= 2000));
      allow delete: if isMember() && resource.data.uid == request.auth.uid;
    }

    // Gemeinsamer Status pro Aktivität (open / planned / done)
    match /activityState/{activityId} {
      allow read: if isMember();
      allow create, update: if isMember()
        && incoming().status in ['open', 'planned', 'done']
        && incoming().updatedBy == request.auth.uid;
      allow delete: if isMember();
    }

    // Gemeinsamer Kommentar-Thread
    match /comments/{commentId} {
      allow read: if isMember();
      allow create: if isMember()
        && incoming().uid == request.auth.uid
        && incoming().body is string
        && incoming().body.size() > 0 && incoming().body.size() <= 2000;
      allow delete: if isMember() && resource.data.uid == request.auth.uid;
    }

    // Vorschläge zwischen den beiden
    match /suggestions/{suggestionId} {
      allow read: if isMember()
        && (resource.data.fromUid == request.auth.uid || resource.data.toUid == request.auth.uid);
      allow create: if isMember()
        && incoming().fromUid == request.auth.uid
        && exists(/databases/$(database)/documents/members/$(incoming().toUid))
        && incoming().response == 'pending';
      allow update: if isMember()
        && resource.data.toUid == request.auth.uid
        && onlyChanges(['response', 'responseNote', 'respondedAt'])
        && incoming().response in ['yes', 'maybe', 'no'];
      allow delete: if isMember() && resource.data.fromUid == request.auth.uid;
    }

    // Alles andere ist gesperrt
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
